# source-in and destination-in clear what is outside the shape.
size 120 60
fillStyle #ff0000
fillRect 10 10 40 40
globalCompositeOperation source-in
fillStyle #0000ff
beginPath
arc 50 30 20 0 6.2831853
fill
globalCompositeOperation source-over
fillStyle #00ff00
fillRect 70 10 40 40
globalCompositeOperation destination-in
fillStyle #000000
beginPath
arc 90 30 15 0 6.2831853
fill
