# Shadows with blur and offset, on a fill and on a stroke.
size 140 100
fillStyle #ffffff
fillRect 0 0 140 100
shadowColor #00000080
shadowBlur 8
shadowOffsetX 6
shadowOffsetY 6
fillStyle #e04040
fillRect 20 20 40 40
shadowColor #0000ff
shadowBlur 0
shadowOffsetX 3
shadowOffsetY -3
fillStyle #40c040
beginPath
arc 100 40 20 0 6.2831853
fill
shadowColor #000000a0
shadowBlur 4
shadowOffsetX 0
shadowOffsetY 4
strokeStyle #202020
lineWidth 4
beginPath
moveTo 20 80
lineTo 120 85
stroke
