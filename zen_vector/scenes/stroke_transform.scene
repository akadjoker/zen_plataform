# A stroke under a non-uniform scale and rotation: the width follows the axes.
size 120 120
fillStyle #ffffff
fillRect 0 0 120 120
strokeStyle #303090
translate 60 60
rotate 0.5
scale 3 1
lineWidth 6
lineJoin miter
beginPath
moveTo -15 -20
lineTo 15 -20
lineTo 15 20
lineTo -15 20
closePath
stroke
lineCap round
lineWidth 3
beginPath
moveTo -12 0
lineTo 12 0
stroke
