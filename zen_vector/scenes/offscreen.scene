# Shapes crossing the canvas edges on every side, with a huge one around it.
size 40 40
fillStyle #ffffff
fillRect 0 0 40 40
fillStyle #404040
beginPath
moveTo -1000 -1000
lineTo 1000 -1000
lineTo 1000 1000
lineTo -1000 1000
closePath
fill evenodd
fillStyle #d04040
beginPath
moveTo -10.5 5.25
lineTo 20.75 -8.5
lineTo 45.5 10.5
lineTo 38.25 44.5
lineTo 12.5 50.75
lineTo -6.5 30.5
closePath
fill
fillStyle #40d040
beginPath
moveTo 20 -20
lineTo 45 50
lineTo -15 10
lineTo 55 10
lineTo -5 50
closePath
fill evenodd
