# drawImage with a source rectangle, scaled up, rotated, and with nearest sampling.
size 140 100
fillStyle #ffffff
fillRect 0 0 140 100
patternImage 16 16
drawImage 0 0 16 16 10 10 32 32
drawImage 4 4 8 8 50 10 40 40
save
translate 110 30
rotate 0.4
drawImage 0 0 16 16 -16 -16 32 32
restore
imageSmoothingEnabled false
drawImage 0 0 8 8 10 55 40 40
drawImage 8 8 8 8 60.5 55.5 30 30
