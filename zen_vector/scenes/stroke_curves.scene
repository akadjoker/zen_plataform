# Stroked curves, tight turns, a closed circle and a self-intersecting path.
size 140 140
fillStyle #ffffff
fillRect 0 0 140 140
strokeStyle #106030
lineWidth 6
lineJoin round
beginPath
moveTo 10 60
bezierCurveTo 10 0 60 0 60 60
bezierCurveTo 60 120 10 120 10 60
stroke
lineWidth 3
beginPath
arc 100 40 25 0 6.283185307
stroke
lineWidth 8
lineJoin miter
beginPath
moveTo 70 80
quadraticCurveTo 140 80 70 130
quadraticCurveTo 20 100 130 100
stroke
lineWidth 12
lineJoin bevel
beginPath
moveTo 20 125
lineTo 60 125
lineTo 22 118
stroke
