# Composite operations on overlapping circles over a transparent background.
size 180 120
fillStyle #ff0000
beginPath
arc 30 30 22 0 6.2831853
fill
globalCompositeOperation destination-over
fillStyle #0000ff
beginPath
arc 45 45 22 0 6.2831853
fill
globalCompositeOperation source-over
fillStyle #ff0000
beginPath
arc 90 30 22 0 6.2831853
fill
globalCompositeOperation source-atop
fillStyle #0000ff80
beginPath
arc 105 45 22 0 6.2831853
fill
globalCompositeOperation source-over
fillStyle #ff0000
beginPath
arc 150 30 22 0 6.2831853
fill
globalCompositeOperation lighter
fillStyle #0000ff
beginPath
arc 165 45 22 0 6.2831853
fill
globalCompositeOperation source-over
fillStyle #ff0000
fillRect 10 80 40 30
globalCompositeOperation xor
fillStyle #00ff00
fillRect 30 90 40 30
globalCompositeOperation source-over
fillStyle #ff0000
fillRect 90 80 40 30
globalCompositeOperation multiply
fillStyle #80ff80
fillRect 110 90 40 30
globalCompositeOperation source-over
fillStyle #ff0000
fillRect 150 80 25 30
globalCompositeOperation destination-out
fillStyle #000000
beginPath
arc 165 95 10 0 6.2831853
fill
